            </div>
            <div class="flex shrink-0 flex-col items-end justify-between gap-2">
              <button type="button" data-del="${i}" aria-label="Eliminar ${esc(p.nombre)}" class="h-7 w-7 rounded-full text-sm opacity-70">🗑️</button>
              <div class="flex items-center gap-1">
                <button type="button" data-menos="${i}" aria-label="Quitar uno" class="h-8 w-8 rounded-full bg-papel2 text-lg font-bold">−</button>
                <span class="w-6 text-center text-sm font-extrabold">${l.cant}</span>
                <button type="button" data-mas="${i}" aria-label="Agregar uno" class="h-8 w-8 rounded-full bg-hoja text-lg font-bold text-papel">+</button>
              </div>
            </div>
          </li>`;
      }).join("");
      $("#total").textContent = cop(tot);
      pintarBilletes();
      actualizarEnlace();
    }

    $("#fab").addEventListener("click", () => { mostrarVista("pedido"); abrirHoja("#modal"); });
    $("#modal").addEventListener("click", (e) => {
      const mas = e.target.closest("[data-mas]"), menos = e.target.closest("[data-menos]"), del = e.target.closest("[data-del]"), ir = e.target.closest("[data-ir-menu]");
      if (mas) cambiarCant(Number(mas.dataset.mas), 1);
      else if (menos) cambiarCant(Number(menos.dataset.menos), -1);
      else if (del) { const l = carrito[Number(del.dataset.del)]; carrito.splice(Number(del.dataset.del), 1); guardar(); pintarCarrito(); if (l) toast(`Quitamos ${nombreLinea(l)}`); }
      else if (ir) { cerrarHoja("#modal"); setTimeout(() => $("#menu").scrollIntoView({ behavior: reducirMovimiento() ? "auto" : "smooth" }), 60); }
    });
    $("#items").addEventListener("input", (e) => {
      const n = e.target.closest("[data-nota]"); if (!n) return;
      const l = carrito[Number(n.dataset.nota)]; if (!l) return;
      l.nota = n.value.slice(0, 100); guardar(); actualizarEnlace();
    });
    $("#clear").addEventListener("click", () => { if (!confirm("¿Vaciar todo el pedido?")) return; carrito = []; guardar(); pintarCarrito(); });

    /* ---- Datos de entrega ---- */
    const CAMPOS = ["nombre", "direccion", "barrio", "referencia"];
    function cargarCliente() {
      const c = LS.get(K_CLIENTE, null);
      if (!c) return;
      CAMPOS.forEach((k) => { if (c[k]) $("#" + k).value = String(c[k]).slice(0, 120); });
      if (c.pago) elegirPago(c.pago, { silencioso: true });
    }
    function elegirPago(valor, { silencioso = false } = {}) {
      if (![...$$("[data-pago]")].some((b) => b.dataset.pago === valor)) return;
      $("#pago").value = valor;
      $$("[data-pago]").forEach((b) => { const on = b.dataset.pago === valor; b.setAttribute("aria-checked", String(on)); b.setAttribute("aria-pressed", String(on)); });
      $("#efectivoBox").hidden = valor !== "Efectivo";
      $("#digitalNota").hidden = !valor || valor === "Efectivo";
      if (!silencioso) vibrar(8);
      actualizarEnlace();
    }
    $("#pagos").addEventListener("click", (e) => { const b = e.target.closest("[data-pago]"); if (b) { $("#err").hidden = true; elegirPago(b.dataset.pago); } });
    function pintarBilletes() {
      const sub = subtotal();
      $("#billetes").innerHTML = [20000, 50000, 100000, 200000].filter((v) => v > sub).slice(0, 3)
        .map((v) => `<button type="button" data-billete="${v}" class="chip !px-3 !py-1.5 !text-xs">${cop(v)}</button>`).join("");
    }
    $("#billetes").addEventListener("click", (e) => { const b = e.target.closest("[data-billete]"); if (b) { $("#pagaCon").value = b.dataset.billete; actualizarEnlace(); } });

    /* ---- Ubicación GPS ---- */
    function estadoUbic(tipo, texto) {
      const el = $("#ubicEstado");
      el.hidden = !texto; el.textContent = texto || "";
      el.className = "text-xs font-semibold " + (tipo === "ok" ? "text-green-700" : tipo === "error" ? "text-red-700" : "text-tierraosc");
    }
    $("#ubicar").addEventListener("click", () => {
      if (!("geolocation" in navigator)) return estadoUbic("error", "Tu navegador no permite compartir la ubicación. Escribe una referencia.");
      estadoUbic("cargando", "Buscando tu ubicación…");
      $("#ubicar").disabled = true;
      navigator.geolocation.getCurrentPosition((pos) => {
        ubicacion = { lat: pos.coords.latitude.toFixed(6), lng: pos.coords.longitude.toFixed(6), precision: Math.round(pos.coords.accuracy || 0) };
        estadoUbic("ok", `✓ Ubicación agregada al pedido${ubicacion.precision ? ` (precisión ±${ubicacion.precision} m)` : ""}`);
        $("#ubicar").textContent = "📍 Actualizar mi ubicación";
        $("#ubicar").disabled = false;
        actualizarEnlace();
      }, (err) => {
        $("#ubicar").disabled = false;
        estadoUbic("error", err.code === 1
          ? "No diste permiso para usar la ubicación. Escribe la dirección y una referencia."
          : "No pudimos obtener tu ubicación. Intenta de nuevo o escribe una referencia.");
      }, { enableHighAccuracy: true, timeout: 12000, maximumAge: 60000 });
    });

    /* ---- Mensaje de WhatsApp ---- */
    const valor = (id) => $("#" + id).value.trim();
    function armarMensaje() {
      const pago = valor("pago"), pagaCon = Math.round(Number(valor("pagaCon")) || 0), e = estadoHorario();
      const lineas = carrito.flatMap((l) => {
        const r = [`• ${l.cant} x ${nombreLinea(l)} — ${cop(precioLinea(l) * l.cant)}`];
        const ex = extrasTexto(l);
        if (ex) r.push(`   + ${ex}`);
        if (l.nota.trim()) r.push(`   ↳ _${l.nota.trim()}_`);
        return r;
      });
      return [
        "*🌱 PEDIDO A DOMICILIO · ANCESTRA*", "",
        `*Cliente:* ${valor("nombre")}`,
        `*Dirección:* ${valor("direccion")}`,
        ...(valor("barrio") ? [`*Barrio / vereda:* ${valor("barrio")}`] : []),
        ...(valor("referencia") ? [`*Referencia:* ${valor("referencia")}`] : []),
        ...(ubicacion ? [`*Ubicación GPS:* https://maps.google.com/?q=${ubicacion.lat},${ubicacion.lng}`] : []),
        "", "*Pedido:*", ...lineas, "",
        `*Subtotal: ${cop(subtotal())}*`,
        "_+ domicilio (por confirmar)_", "",
        `*Pago:* ${pago}${pago === "Efectivo" && pagaCon ? ` · paga con ${cop(pagaCon)}` : ""}`,
        ...(e.abierto ? [] : ["", "_(Pedido enviado fuera del horario de atención)_"])
      ].join("\n");
    }
    function actualizarEnlace() { const url = waUrl(armarMensaje()); $("#confirmar").href = url; $("#reabrir").href = url; }
    ["nombre", "direccion", "barrio", "referencia", "pagaCon"].forEach((id) => $("#" + id).addEventListener("input", () => { $("#err").hidden = true; actualizarEnlace(); }));

    function validar() {
      if (!cantidadTotal()) return { msg: "Tu pedido está vacío." };
      if (valor("nombre").length < 2) return { msg: "Escribe tu nombre.", foco: "#nombre" };
      if (valor("direccion").length < 5) return { msg: "Escribe la dirección de entrega completa.", foco: "#direccion" };
      if (!valor("pago")) return { msg: "Elige cómo vas a pagar.", foco: "[data-pago]" };
      const pagaCon = Number(valor("pagaCon"));
      if (valor("pago") === "Efectivo" && valor("pagaCon") && pagaCon < subtotal()) return { msg: `El efectivo con el que pagas (${cop(pagaCon)}) es menor que el subtotal (${cop(subtotal())}).`, foco: "#pagaCon" };
      return null;
    }
    $("#confirmar").addEventListener("click", (e) => {
      const problema = validar(), err = $("#err");
      if (problema) {
        e.preventDefault();
        err.textContent = problema.msg; err.hidden = false;
        const f = $(problema.foco || "#nombre"); f?.focus(); f?.scrollIntoView({ block: "center", behavior: reducirMovimiento() ? "auto" : "smooth" });
        vibrar([30, 40, 30]);
        return;
      }
      err.hidden = true;
      actualizarEnlace();
      if ($("#recordar").checked) LS.set(K_CLIENTE, { ...Object.fromEntries(CAMPOS.map((k) => [k, valor(k)])), pago: valor("pago") });
      else LS.del(K_CLIENTE);
      LS.set(K_ULTIMO, { lineas: carrito.map((l) => ({ ...l })), total: subtotal(), fecha: Date.now() });
      setTimeout(() => mostrarVista("listo"), 300);
    });
    $("#form").addEventListener("submit", (e) => { e.preventDefault(); $("#confirmar").click(); });

    function mostrarVista(v) {
      $("#vistaPedido").hidden = v !== "pedido";
      $("#vistaListo").hidden = v !== "listo";
    }
    $("#volverPedido").addEventListener("click", () => mostrarVista("pedido"));
    $("#nuevoPedido").addEventListener("click", () => {
      carrito = []; guardar(); ubicacion = null; estadoUbic(); $("#ubicar").textContent = "📍 Compartir mi ubicación exacta";
      $("#pagaCon").value = ""; pintarCarrito(); mostrarVista("pedido"); cerrarHoja("#modal"); pintarRepetir();
      window.scrollTo({ top: 0, behavior: reducirMovimiento() ? "auto" : "smooth" });
    });

    /* ---- Repetir el último pedido ---- */
    function pintarRepetir() {
      const u = LS.get(K_ULTIMO, null), lineas = (u?.lineas || []).filter((l) => lineaValida(l));
      const btn = $("#repetir");
      btn.hidden = !lineas.length || cantidadTotal() > 0;
      if (!lineas.length) return;
      const n = lineas.reduce((s, l) => s + l.cant, 0);
      $("#repetirInfo").textContent = `${n} producto${n === 1 ? "" : "s"} · ${lineas.map((l) => porId(l.id).nombre).slice(0, 3).join(", ")}${lineas.length > 3 ? "…" : ""}`;
    }
    $("#repetir").addEventListener("click", () => {
      const u = LS.get(K_ULTIMO, null);
      (u?.lineas || []).filter((l) => lineaValida(l)).forEach((l) => agregar(l, l.cant, { silencioso: true }));
      pintarRepetir(); vibrar(); mostrarVista("pedido"); abrirHoja("#modal");
    });

    /* ---- Compartir la carta ---- */
    $("#compartir").addEventListener("click", async () => {
      const datos = { title: "Ancestra · Hamburguesas", text: "Mira la carta de Ancestra, agricultura de origen:", url: location.href.split("#")[0] };
      try {
        if (navigator.share) await navigator.share(datos);
        else { await navigator.clipboard.writeText(datos.url); toast("Enlace copiado"); }
      } catch (e) { if (e?.name !== "AbortError") toast("No se pudo compartir el enlace"); }
    });

    /* =====================================================================
       INICIO
       ===================================================================== */
    if ("scrollRestoration" in history) history.scrollRestoration = "manual";
    pintarMenu();
    enlazarWhatsApp();
    cargarCliente();
    vigilarSecciones();
    pintarHorario();
    if (HORARIO) setInterval(pintarHorario, 60000);
    pintarCarrito();
    pintarRepetir();
    revelar();
    $("#anio").textContent = new Date().getFullYear();
  })();
  </script>
</body>
</html>
