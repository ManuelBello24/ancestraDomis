      const p = porId(l.id);
      let v = p.precio;
      grupos(p).forEach((g, i) => { v += g.items.find((o) => o.nombre === l.op[i])?.extra || 0; });
      (l.ex || []).forEach((id) => { v += porId(id)?.precio || 0; });
      return v;
    }
    const nombreLinea = (l) => { const p = porId(l.id), op = l.op || []; return p.nombre + (op.length ? ` (${op.join(", ")})` : ""); };
