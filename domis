    function agregar(datos, cant = 1, { silencioso = false } = {}) {
      const nueva = { id: Number(datos.id), op: datos.op || [], ex: (datos.ex || []).map(Number), nota: String(datos.nota || "").trim().slice(0, 100), cant: 1 };
      if (!lineaValida(nueva)) return;
      const f = firma(nueva);
      let l = carrito.find((x) => firma(x) === f);
      if (l) l.cant = Math.min(99, l.cant + cant);
      else { l = { ...nueva, cant: Math.min(99, cant) }; carrito.push(l); }
      guardar(); pintarCarrito();
      if (silencioso) return;
      vibrar(); rebotarBarra();
      ultimoAgregado = { f, cant };
      toast(`✓ ${cant > 1 ? cant + " × " : ""}${nombreLinea(l)}`, { accion: "Deshacer", alAccion: deshacer });
