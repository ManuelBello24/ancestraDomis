    .c-s { fill: var(--ls, currentColor); }

    /* Logo oficial de WhatsApp */
    :root { --wa-logo: url("data:image/png;base64,"); }
    .wa-ico { display: inline-block; flex-shrink: 0; width: 1.5em; height: 1.5em; vertical-align: -.4em; background: var(--wa-logo) center / contain no-repeat; }
    .wa-circulo { background: var(--wa-logo) center / contain no-repeat; }
    .safe-pb { padding-bottom: calc(1.5rem + env(safe-area-inset-bottom)); }

    /* =============== HERO · combinaciones de color del manual =============== */
    .hero { background-color: var(--h-bg); color: var(--h-text); transition: background-color .7s ease, color .7s ease; }
