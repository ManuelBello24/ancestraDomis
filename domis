    /* ---- Movimiento al bajar: sello que gira, ilustraciones con paralaje ---- */
    const sello = $(".hero-sello"), decos = $$("[data-paralaje]");
    let pendiente = false;
    function alDesplazar() {
      pendiente = false;
      const y = window.scrollY, vh = window.innerHeight;
