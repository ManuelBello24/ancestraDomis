      { id: 27, nombre: "Salsa brava", precio: 2000, descripcion: "Adicional de nuestra salsa brava de la casa.", categoria: "adicionales", picante: true }
    ];

    /* =====================================================================
       UTILIDADES
       ===================================================================== */
    const $ = (s, r = document) => r.querySelector(s);
    const $$ = (s, r = document) => [...r.querySelectorAll(s)];
    const fmtNum = new Intl.NumberFormat("es-CO", { maximumFractionDigits: 0 });
    const cop = (n) => "$ " + fmtNum.format(Math.round(Number(n) || 0));
    const esc = (t) => String(t ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
    const norm = (t) => String(t ?? "").normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
    const waUrl = (texto) => `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(texto)}`;
    const reducirMovimiento = () => window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
    const vibrar = (ms = 12) => { try { navigator.vibrate?.(ms); } catch { /* sin vibración */ } };
    const LS = {
      get(k, def) { try { const v = JSON.parse(localStorage.getItem(k) || "null"); return v ?? def; } catch { return def; } },
      set(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch { /* modo privado */ } },
      del(k) { try { localStorage.removeItem(k); } catch { /* nada */ } }
    };
    const K_CARRITO = "anc_dom_carrito", K_CLIENTE = "anc_dom_cliente", K_ULTIMO = "anc_dom_ultimo";

    // Tamaños de las ilustraciones del manual (para dibujarlas con <use>)
    const VB = {"logo-arco": [625, 447], "logo-horizontal": [789, 340], "logo-palabra": [781, 108], "logo-marca": [476, 470], "logo-sello": [582, 582], "logo-sol": [609, 570], "i-pan": [268, 97], "i-sol": [187, 217], "i-hojas": [214, 237], "i-olla": [230, 151], "i-caballo": [198, 197], "i-planta": [220, 159], "i-brote": [161, 186], "i-ramas": [192, 237]};
    const ilus = (id, cls = "") => { const [w, h] = VB[id]; return `<svg viewBox="0 0 ${w} ${h}" class="${cls}" aria-hidden="true"><use href="#${id}" width="${w}" height="${h}"/></svg>`; };

    const porId = (id) => PRODUCTOS.find((p) => p.id === Number(id));
    const catDe = (p) => String(p.categoria || "").split(" ")[0] || "hamburguesas";
    const grupos = (p) => (Array.isArray(p?.opciones) ? p.opciones : []);
    const EXTRAS = EXTRAS_IDS.map(porId).filter(Boolean);
    const conExtras = (p) => EXTRAS.length > 0 && EXTRAS_EN.includes(catDe(p));
    const precioDesde = (p) => p.precio + grupos(p).reduce((s, g) => s + Math.min(...g.items.map((o) => o.extra || 0)), 0);
    const numero = (p) => `<span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-dark font-slab text-2xl font-extrabold text-papel" aria-hidden="true">${p.id}</span>`;

    /* =====================================================================
       HORARIO
       ===================================================================== */
    const DIAS = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
    const DIAS_ES = ["el domingo", "el lunes", "el martes", "el miércoles", "el jueves", "el viernes", "el sábado"];
    const fmtHora = (m) => { if (m === 12 * 60) return "12:00 m."; if (m === 24 * 60) return "12 de la noche"; const h = Math.floor(m / 60) % 24; return `${((h + 11) % 12) + 1}:${String(m % 60).padStart(2, "0")} ${h < 12 ? "AM" : "PM"}`; };
    function ahoraEnTienda() {
      const v = Object.fromEntries(new Intl.DateTimeFormat("en-US", { timeZone: HORARIO.zona, weekday: "short", hour: "numeric", minute: "numeric", hourCycle: "h23" })
        .formatToParts(new Date()).map((p) => [p.type, p.value]));
      return { dia: v.weekday, min: (parseInt(v.hour, 10) % 24) * 60 + parseInt(v.minute, 10) };
    }
    function estadoHorario() {
      if (!HORARIO) return { abierto: true, sinHorario: true };
      const { dia, min } = ahoraEnTienda(), hoy = HORARIO.dias.includes(dia);
      if (hoy && min >= HORARIO.abre && min < HORARIO.cierra) {
        const faltan = HORARIO.cierra - min;
        return faltan <= 45
          ? { abierto: true, color: "#FE8E7A", texto: `Cerramos en ${faltan} min · ¡pide ya!` }
          : { abierto: true, color: "#D6FF02", texto: `Abierto ahora · hasta las ${fmtHora(HORARIO.cierra)}` };
      }
      let cuando = "";
      if (hoy && min < HORARIO.abre) cuando = `hoy a las ${fmtHora(HORARIO.abre)}`;
      else {
        const i = DIAS.indexOf(dia);
        for (let k = 1; k <= 7; k++) {
          const d = (i + k) % 7;
          if (HORARIO.dias.includes(DIAS[d])) { cuando = `${k === 1 ? "mañana" : DIAS_ES[d]} a las ${fmtHora(HORARIO.abre)}`; break; }
        }
      }
      return { abierto: false, color: "#ef4444", cuando, texto: `Cerrado · abrimos ${cuando}` };
    }
    function pintarHorario() {
      const e = estadoHorario();
      $$("[data-estado-wrap]").forEach((el) => { el.hidden = !!e.sinHorario; });
      $$("[data-punto]").forEach((el) => { el.hidden = !!e.sinHorario; if (!e.sinHorario) { el.style.backgroundColor = e.color; el.style.boxShadow = `0 0 8px ${e.color}`; } });
      $$("[data-estado]").forEach((el) => { el.textContent = e.texto || ""; });
      const aviso = $("#avisoCerrado");
      aviso.hidden = e.abierto;
      aviso.textContent = e.abierto ? "" : `Estamos cerrados en este momento (abrimos ${e.cuando}). Puedes enviar tu pedido y lo atendemos apenas abramos.`;
    }

    /* =====================================================================
       CARRITO · cada línea = { id, op: [...], ex: [...], nota, cant }
       ===================================================================== */
    function lineaValida(l) {
      const p = porId(l?.id);
      if (!p || !Number.isInteger(l.cant) || l.cant < 1) return false;
      const g = grupos(p), op = Array.isArray(l.op) ? l.op : [], ex = Array.isArray(l.ex) ? l.ex : [];
      if (op.length !== g.length || !g.every((gr, i) => gr.items.some((o) => o.nombre === op[i]))) return false;
      return ex.every((id) => EXTRAS_IDS.includes(Number(id))) && (!ex.length || conExtras(p));
