        d.style.setProperty("--py", ((r.top - vh / 2) * -Number(d.dataset.paralaje)).toFixed(1));
      });
    }
    if (!reducirMovimiento()) {
      window.addEventListener("scroll", () => { if (!pendiente) { pendiente = true; requestAnimationFrame(alDesplazar); } }, { passive: true });
