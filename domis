    let carrito = (LS.get(K_CARRITO, []) || []).filter((l) => lineaValida(l)).map((l) => ({ id: Number(l.id), op: l.op || [], ex: (l.ex || []).map(Number), nota: String(l.nota || "").slice(0, 100), cant: Math.min(99, l.cant) }));
    const guardar = () => LS.set(K_CARRITO, carrito);
    const cantidadTotal = () => carrito.reduce((s, l) => s + l.cant, 0);
